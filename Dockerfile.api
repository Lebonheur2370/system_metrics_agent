# Version figée : build reproductible, jamais "latest"
ARG PYTHON_VERSION=3.12.7

# ---------- Étape 1 : builder ----------
FROM python:${PYTHON_VERSION}-slim AS builder

WORKDIR /build

# Environnement virtuel isolé, facile à copier dans l'étape finale
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# requirements.txt copié AVANT le code pour profiter du cache Docker
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ---------- Étape 2 : image finale ----------
FROM python:${PYTHON_VERSION}-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# Utilisateur système sans privilèges
RUN groupadd --system app && \
    useradd --system --gid app --no-create-home --no-log-init app

WORKDIR /app

# On ne récupère que les dépendances installées, pas les outils du builder
COPY --from=builder /opt/venv /opt/venv
COPY app/ ./app/

USER app

EXPOSE 8000

# Healthcheck en Python : l'image slim ne contient pas curl
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)"]

# Production : pas de --reload, écoute sur toutes les interfaces
CMD ["uvicorn", "app.api:app", "--host", "0.0.0.0", "--port", "8000"]